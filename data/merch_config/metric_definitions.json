[
  { "metricId": "salesAmount", "label": "销售额", "description": "实际成交金额（含折扣）", "unit": "currency", "formula": "salesPairs * avgSellingPrice", "defaultMetricType": "standard", "usedBy": ["overview","annual-control","region-store","category-ops","wave-planning","otb","forecast","pnl","inventory-health"], "source": "merch_config" },
  { "metricId": "netSalesAmount", "label": "净销售额", "description": "销售额扣减退货金额后的净值", "unit": "currency", "formula": "salesAmount - returnAmount", "defaultMetricType": "standard", "usedBy": ["pnl","forecast"], "source": "merch_config" },
  { "metricId": "retailSalesAmount", "label": "吊牌销售额", "description": "按零售吊牌价计算的销售金额", "unit": "currency", "formula": "salesPairs * retailPrice", "defaultMetricType": "reference", "usedBy": ["category-ops","otb","inventory-health"], "source": "merch_config" },
  { "metricId": "salesPairs", "label": "销售双数", "description": "实际销售出库的商品双数", "unit": "pairs", "formula": "sum(outbound pairs)", "defaultMetricType": "standard", "usedBy": ["region-store","category-ops","wave-planning","otb","forecast"], "source": "merch_config" },
  { "metricId": "avgSellingPrice", "label": "平均成交价", "description": "销售额 / 销售双数", "unit": "currency", "formula": "salesAmount / salesPairs", "defaultMetricType": "standard", "usedBy": ["region-store","consumer","category-ops","forecast","competitor-trend"], "source": "merch_config" },
  { "metricId": "discountRate", "label": "折扣率", "description": "平均成交价 / 零售吊牌价，反映实际折扣力度", "unit": "percent", "formula": "avgSellingPrice / retailPrice", "defaultMetricType": "standard", "usedBy": ["region-store","consumer","otb","forecast","pnl","competitor-trend"], "source": "merch_config" },
  { "metricId": "salesAchievementRate", "label": "销售达成率", "description": "实际销售额 / 目标销售额", "unit": "percent", "formula": "salesAmount / salesTarget", "defaultMetricType": "standard", "usedBy": ["overview","annual-control","region-store"], "source": "merch_config" },
  { "metricId": "yoyGrowth", "label": "同比增长", "description": "本期指标 vs 去年同期，增长幅度", "unit": "percent", "formula": "(current - lastYear) / lastYear", "defaultMetricType": "standard", "usedBy": ["overview","forecast","region-store"], "source": "merch_config" },
  { "metricId": "momGrowth", "label": "环比增长", "description": "本期指标 vs 上期，增长幅度", "unit": "percent", "formula": "(current - last) / last", "defaultMetricType": "standard", "usedBy": ["forecast","region-store"], "source": "merch_config" },
  { "metricId": "sellThroughRate", "label": "售罄率", "description": "销售数量 / 上市可售数量，反映商品去化效率", "unit": "percent", "formula": "salesPairs / availableLaunchPairs", "defaultMetricType": "standard", "usedBy": ["category-ops","wave-planning","otb","inventory-health"], "source": "merch_config" },
  { "metricId": "inventoryCost", "label": "库存成本", "description": "当前库存按采购成本价计算的金额", "unit": "currency", "formula": "inventoryPairs * costPrice", "defaultMetricType": "standard", "usedBy": ["overview","annual-control","region-store","category-ops","otb","inventory-health"], "source": "merch_config" },
  { "metricId": "inventoryRetail", "label": "吊牌库存", "description": "当前库存按零售吊牌价计算的金额", "unit": "currency", "formula": "inventoryPairs * retailPrice", "defaultMetricType": "reference", "usedBy": ["inventory-health","category-ops"], "source": "merch_config" },
  { "metricId": "sellableInventory", "label": "可售库存", "description": "扣除残损、赠品后仍可销售的库存", "unit": "currency", "formula": "inventoryCost - damagedInventory - giftInventory", "defaultMetricType": "standard", "usedBy": ["inventory-health"], "source": "merch_config" },
  { "metricId": "agedInventory", "label": "库龄库存", "description": "上市超过180天（秋冬90天）的滞销库存金额", "unit": "currency", "formula": "sum(inventoryCost where age > threshold)", "defaultMetricType": "standard", "usedBy": ["category-ops","inventory-health"], "source": "merch_config" },
  { "metricId": "weeksOfSupply", "label": "库存周数", "description": "当前库存 / 近4周平均销售速度，预估可售周数", "unit": "weeks", "formula": "inventoryPairs / avgWeeklySales", "defaultMetricType": "standard", "usedBy": ["region-store","inventory-health"], "source": "merch_config" },
  { "metricId": "stockToSalesRatio", "label": "存销比", "description": "月末库存 / 当月销售额，反映库存压力", "unit": "ratio", "formula": "endingInventory / monthlySales", "defaultMetricType": "standard", "usedBy": ["region-store","otb","wave-planning","inventory-health"], "source": "merch_config" },
  { "metricId": "inventoryTurnover", "label": "库存周转", "description": "年化销售成本 / 平均库存成本", "unit": "times", "formula": "annualCOGS / avgInventoryCost", "defaultMetricType": "standard", "usedBy": ["category-ops","inventory-health"], "source": "merch_config" },
  { "metricId": "brokenSizeRate", "label": "断码率", "description": "尺码缺货SKU数 / 总在售SKU数", "unit": "percent", "formula": "brokenSizeSKU / totalActiveSKU", "defaultMetricType": "standard", "usedBy": ["region-store","inventory-health"], "source": "merch_config" },
  { "metricId": "skuCount", "label": "SKU数", "description": "款色码三级组合的在售SKU总数", "unit": "count", "formula": "count(distinct styleId + colorId + sizeId)", "defaultMetricType": "standard", "usedBy": ["category-ops","otb"], "source": "merch_config" },
  { "metricId": "skcCount", "label": "SKC数", "description": "款色二级组合的在售SKC总数（款×色）", "unit": "count", "formula": "count(distinct styleId + colorId)", "defaultMetricType": "standard", "usedBy": ["category-ops","otb"], "source": "merch_config" },
  { "metricId": "styleCount", "label": "款数", "description": "计划或在售的款式总数", "unit": "count", "formula": "count(distinct styleId)", "defaultMetricType": "standard", "usedBy": ["category-ops","otb","wave-planning"], "source": "merch_config" },
  { "metricId": "colorCount", "label": "色数", "description": "每款平均配色数量", "unit": "count", "formula": "skcCount / styleCount", "defaultMetricType": "reference", "usedBy": ["category-ops","otb"], "source": "merch_config" },
  { "metricId": "averageDepth", "label": "均深", "description": "每SKC平均计划备货双数", "unit": "pairs", "formula": "plannedProductionPairs / skcCount", "defaultMetricType": "standard", "usedBy": ["category-ops","otb","wave-planning"], "source": "merch_config" },
  { "metricId": "categorySalesRatio", "label": "品类销售占比", "description": "该品类销售额 / 全品类销售额合计", "unit": "percent", "formula": "categorySalesAmount / totalSalesAmount", "defaultMetricType": "standard", "usedBy": ["consumer","category-ops","forecast","competitor-trend"], "source": "merch_config" },
  { "metricId": "priceBandSalesRatio", "label": "价格带销售占比", "description": "该价格带销售额 / 全价格带销售额合计", "unit": "percent", "formula": "priceBandSalesAmount / totalSalesAmount", "defaultMetricType": "standard", "usedBy": ["consumer","category-ops","otb","competitor-trend"], "source": "merch_config" },
  { "metricId": "channelSalesRatio", "label": "渠道销售占比", "description": "该渠道销售额 / 全渠道销售额合计，用于判断渠道结构是否匹配计划", "unit": "percent", "formula": "channelSalesAmount / totalSalesAmount", "defaultMetricType": "standard", "usedBy": ["overview","region-store","forecast","otb"], "source": "merch_config" },
  { "metricId": "productRoleRatio", "label": "货品角色占比", "description": "引流款/利润款/形象款等角色在销售额中的占比", "unit": "percent", "formula": "roleAmount / totalSalesAmount", "defaultMetricType": "reference", "usedBy": ["category-ops","otb"], "source": "merch_config" },
  { "metricId": "seasonSalesTarget", "label": "季节销售目标", "description": "全年销售目标按春夏/秋冬拆分后的季节目标额", "unit": "currency", "formula": "annualTarget * seasonRatio", "defaultMetricType": "standard", "usedBy": ["annual-control","wave-planning","otb"], "source": "merch_config" },
  { "metricId": "waveSalesTarget", "label": "波段销售目标", "description": "季节目标按波段拆分后的波段销售目标额", "unit": "currency", "formula": "seasonSalesTarget * waveSalesRatio", "defaultMetricType": "standard", "usedBy": ["wave-planning","otb"], "source": "merch_config" },
  { "metricId": "launchDate", "label": "上市日期", "description": "商品正式在门店/线上开始销售的日期", "unit": "date", "formula": "–", "defaultMetricType": "dimension", "usedBy": ["wave-planning","otb"], "source": "merch_config" },
  { "metricId": "launchPhase", "label": "上市阶段", "description": "商品处于哪个生命周期阶段（爬坡/主销/清货等）", "unit": "text", "formula": "based on launchDate + season lifecycle standards", "defaultMetricType": "dimension", "usedBy": ["wave-planning","inventory-health"], "source": "merch_config" },
  { "metricId": "cumulativeSellThroughRate", "label": "累计售罄率", "description": "从上市日至今累计销售双数 / 上市可售双数", "unit": "percent", "formula": "cumulativeSalesPairs / availableLaunchPairs", "defaultMetricType": "standard", "usedBy": ["wave-planning","category-ops","inventory-health"], "source": "merch_config" },
  { "metricId": "purchaseBudget", "label": "采购预算", "description": "年度/季节OTB批准的采购总预算", "unit": "currency", "formula": "annualOTBBudget", "defaultMetricType": "standard", "usedBy": ["overview","annual-control","otb"], "source": "merch_config" },
  { "metricId": "plannedPurchaseAmount", "label": "计划采购金额", "description": "波段/品类维度计划采购的金额", "unit": "currency", "formula": "plannedProductionPairs * costPrice", "defaultMetricType": "standard", "usedBy": ["otb","wave-planning"], "source": "merch_config" },
  { "metricId": "orderedAmount", "label": "已下单金额", "description": "已向供应商正式下单的采购金额", "unit": "currency", "formula": "sum(confirmedPO amount)", "defaultMetricType": "standard", "usedBy": ["otb"], "source": "merch_config" },
  { "metricId": "arrivedAmount", "label": "已到货金额", "description": "供应商已发货入库的采购金额", "unit": "currency", "formula": "sum(arrived PO amount)", "defaultMetricType": "standard", "usedBy": ["otb"], "source": "merch_config" },
  { "metricId": "plannedProductionPairs", "label": "计划投产双数", "description": "计划向供应商下单生产的双数", "unit": "pairs", "formula": "styleCount * avgDepth * skcColorCount", "defaultMetricType": "standard", "usedBy": ["wave-planning","otb"], "source": "merch_config" },
  { "metricId": "arrivalRate", "label": "到货率", "description": "已到货双数 / 计划采购双数", "unit": "percent", "formula": "arrivedPairs / plannedPurchasePairs", "defaultMetricType": "standard", "usedBy": ["otb","wave-planning"], "source": "merch_config" },
  { "metricId": "sellThroughTarget", "label": "售罄目标", "description": "计划在生命周期末达到的目标售罄率", "unit": "percent", "formula": "targetSellThroughRate (config)", "defaultMetricType": "standard", "usedBy": ["wave-planning","otb","category-ops"], "source": "merch_config" },
  { "metricId": "markupRate", "label": "倍率", "description": "零售价 / 采购成本价的倍数", "unit": "ratio", "formula": "retailPrice / costPrice", "defaultMetricType": "standard", "usedBy": ["otb","pnl"], "source": "merch_config" },
  { "metricId": "salesRevenue", "label": "销售收入", "description": "损益口径下的确认收入，含折扣后净额", "unit": "currency", "formula": "netSalesAmount", "defaultMetricType": "standard", "usedBy": ["pnl"], "source": "merch_config" },
  { "metricId": "cogs", "label": "销售成本", "description": "与销售收入匹配的商品成本（含仓配）", "unit": "currency", "formula": "salesPairs * costPrice + warehouseCost", "defaultMetricType": "standard", "usedBy": ["pnl"], "source": "merch_config" },
  { "metricId": "grossProfit", "label": "毛利", "description": "销售收入 - 销售成本", "unit": "currency", "formula": "salesRevenue - cogs", "defaultMetricType": "standard", "usedBy": ["pnl"], "source": "merch_config" },
  { "metricId": "grossMarginRate", "label": "毛利率", "description": "毛利 / 销售收入，反映基本盈利能力", "unit": "percent", "formula": "grossProfit / salesRevenue", "defaultMetricType": "standard", "usedBy": ["overview","annual-control","category-ops","pnl"], "source": "merch_config" },
  { "metricId": "operatingExpense", "label": "经营费用", "description": "营销、渠道、人工、仓储、物流等运营费用合计", "unit": "currency", "formula": "marketingCost + channelFee + laborCost + warehousingCost + logisticsCost", "defaultMetricType": "standard", "usedBy": ["pnl"], "source": "merch_config" },
  { "metricId": "netProfit", "label": "净利润", "description": "毛利 - 经营费用 - 税费", "unit": "currency", "formula": "grossProfit - operatingExpense - tax", "defaultMetricType": "standard", "usedBy": ["pnl"], "source": "merch_config" },
  { "metricId": "netProfitRate", "label": "净利率", "description": "净利润 / 销售收入", "unit": "percent", "formula": "netProfit / salesRevenue", "defaultMetricType": "standard", "usedBy": ["pnl","annual-control"], "source": "merch_config" },
  { "metricId": "cashInFromSales", "label": "销售回款", "description": "实际收到客户/平台付款的现金流入", "unit": "currency", "formula": "netSalesAmount * collectionRate(t + collectionDays)", "defaultMetricType": "standard", "usedBy": ["overview"], "source": "merch_config" },
  { "metricId": "cashOutForPurchase", "label": "采购付款", "description": "向供应商支付货款的现金流出", "unit": "currency", "formula": "purchaseBudget * (depositRate(t) + balanceRate(t + paymentDays))", "defaultMetricType": "standard", "usedBy": ["otb"], "source": "merch_config" },
  { "metricId": "cashOutForExpense", "label": "费用支出", "description": "营销、人工、平台等经营费用的现金流出", "unit": "currency", "formula": "sum(operatingExpense payments)", "defaultMetricType": "standard", "usedBy": [], "source": "merch_config" },
  { "metricId": "netCashflow", "label": "净现金流", "description": "销售回款 - 采购付款 - 费用支出", "unit": "currency", "formula": "cashInFromSales - cashOutForPurchase - cashOutForExpense", "defaultMetricType": "standard", "usedBy": ["overview"], "source": "merch_config" },
  { "metricId": "endingCashBalance", "label": "期末现金余额", "description": "期初现金余额 + 净现金流", "unit": "currency", "formula": "beginningCash + netCashflow", "defaultMetricType": "standard", "usedBy": [], "source": "merch_config" },
  { "metricId": "fundingGap", "label": "资金缺口", "description": "期末现金余额低于最低现金余额时的差额", "unit": "currency", "formula": "max(0, minimumCashBalance - endingCashBalance)", "defaultMetricType": "standard", "usedBy": ["overview","otb","inventory-health"], "source": "merch_config" },
  { "metricId": "inventoryCapitalOccupied", "label": "库存占款", "description": "库存成本中尚未通过销售回收的资金沉淀", "unit": "currency", "formula": "inventoryCost - (salesRevenue - grossProfit) * recoveryRate", "defaultMetricType": "standard", "usedBy": ["inventory-health"], "source": "merch_config" }
]
